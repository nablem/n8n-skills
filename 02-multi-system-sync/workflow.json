      ],
      "id": "33062136-9a84-4eda-9ef5-96ec829caf58",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "content": "## Notice the conflicts:\n\n- CUST-001: different email, newer timestamp in System B\n- CUST-002: different phone & credit limit, newer in System B\n- CUST-003: identical (no conflict)",
        "height": 176,
        "width": 480
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -272,
        -416
      ],
      "typeVersion": 1,
      "id": "58d9b2e3-3cb5-4760-8f11-3e1e92076f0d",
      "name": "Sticky Note"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        64,
        -112
      ],
      "id": "672b4bdb-2e67-447a-a5d0-c69b25904c42",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all().map(item => item.json);\n\nconst systemAData = allItems.slice(0, 3);\nconst systemBData = allItems.slice(3, 6);\n\nconst conflicts = [];\n\nsystemAData.forEach((customerA, index) => {\n  const customerB = systemBData[index];\n  \n  const fieldsToCompare = ['name', 'email', 'phone', 'creditLimit'];\n  const differences = [];\n  \n  fieldsToCompare.forEach(field => {\n    if (customerA[field] !== customerB[field]) {\n      differences.push({\n        field: field,\n        systemA: customerA[field],\n        systemB: customerB[field]\n      });\n    }\n  });\n  \n  if (differences.length > 0) {\n    const dateA = new Date(customerA.lastModified);\n    const dateB = new Date(customerB.lastModified);\n    const newerSource = dateB > dateA ? 'systemB' : 'systemA';\n    \n    conflicts.push({\n      customerId: customerA.customerId,\n      differences: differences,\n      systemA: customerA,\n      systemB: customerB,\n      newerSource: newerSource,\n      conflictDetectedAt: new Date().toISOString()\n    });\n  }\n});\n\nreturn conflicts.length > 0 ? conflicts : [{ message: \"No conflicts detected\" }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        -112
      ],
      "id": "89e3eeb6-4fd9-4038-8ed0-39b1f7c5e3d7",
      "name": "Detect Conflicts"
    },
    {
      "parameters": {
        "jsCode": "const conflicts = $input.all().map(item => item.json);\n\nconst resolved = conflicts.map(conflict => {\n  const mergedCustomer = conflict.newerSource === 'systemB' \n    ? { ...conflict.systemB } \n    : { ...conflict.systemA };\n  \n  return {\n    customerId: conflict.customerId,\n    resolvedData: mergedCustomer,\n    resolution: {\n      strategy: \"newest_wins\",\n      chosenSource: conflict.newerSource,\n      fieldsUpdated: conflict.differences.map(d => d.field),\n      resolvedAt: new Date().toISOString()\n    },\n    originalConflict: conflict.differences\n  };\n});\n\nreturn resolved;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        -112
      ],
      "id": "93d359f4-8bbc-42e3-a415-20f7071f7e88",
      "name": "Resolve Conflicts (Newest Wins)"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "https://httpbin.org/put",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.resolvedData }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        736,
        -304
      ],
      "id": "493338a7-cd62-43cf-bac9-856141354eeb",
