        "method": "PUT",
        "url": "https://httpbin.org/put",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.resolvedData }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        736,
        -112
      ],
      "id": "1fc6ceec-0ff7-47b7-bbea-1a2ff4f447a8",
      "name": "Update System B",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const resolved = $input.all().map(item => item.json);\n\nconst syncLog = {\n  syncId: `SYNC-${Date.now()}`,\n  syncedAt: new Date().toISOString(),\n  totalConflicts: resolved.length,\n  customersUpdated: JSON.stringify(resolved.map(r => ({\n    customerId: r.customerId,\n    fieldsUpdated: r.resolution.fieldsUpdated,\n    strategy: r.resolution.strategy,\n    chosenSource: r.resolution.chosenSource\n  }))),\n  status: \"completed\"\n};\n\nreturn syncLog;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
