      "name": "Webhook (receive invoice)",
      "webhookId": "63c89e5c-a76d-46a7-b185-9c2710d8e67f"
    },
    {
      "parameters": {
        "jsCode": "const invoice = $input.first().json.body;\n\nconst errors = [];\nlet isValid = true;\n\nif (!invoice.invoiceNumber) {\n  errors.push(\"Missing invoiceNumber\");\n  isValid = false;\n}\n\nif (!invoice.customerName) {\n  errors.push(\"Missing customerName\");\n  isValid = false;\n}\n\nif (!invoice.date) {\n  errors.push(\"Missing date\");\n  isValid = false;\n} else {\n  const dateRegex = /^\\d{4}-\\d{2}-\\d{2}$/;\n  if (!dateRegex.test(invoice.date)) {\n    errors.push(\"Invalid date format, expected YYYY-MM-DD\");\n    isValid = false;\n  }\n}\n\nif (!invoice.items || !Array.isArray(invoice.items) || invoice.items.length === 0) {\n  errors.push(\"Missing or empty items array\");\n  isValid = false;\n}\n\nif (invoice.totalAmount === undefined || invoice.totalAmount === null) {\n  errors.push(\"Missing totalAmount\");\n  isValid = false;\n}\n\nif (invoice.items && Array.isArray(invoice.items) && invoice.totalAmount !== undefined) {\n  const calculatedTotal = invoice.items.reduce((sum, item) => sum + (item.amount || 0), 0);\n  if (calculatedTotal !== invoice.totalAmount) {\n    errors.push(`Total amount mismatch: calculated ${calculatedTotal}, provided ${invoice.totalAmount}`);\n    isValid = false;\n  }\n}\n\nreturn {\n  ...invoice,\n  isValid,\n  errors,\n  validatedAt: new Date().toISOString()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1280,
        -192
      ],
      "id": "345dd1f4-12e4-4f4e-b928-910e0626fc93",
      "name": "Code (validate invoice data)"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nreturn {\n  ...data,\n  status: \"rejected\",\n  errorCount: data.errors.length,\n  reviewRequired: true,\n  rejectedAt: $now.toISO()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
