      "id": "12320ed9-0877-4a85-9c18-2c418860d1d8",
      "name": "Fetch Region C Sales"
    },
    {
      "parameters": {
        "jsCode": "const allRegions = $input.all().map(item => item.json);\n\nconst totalOrders = allRegions.reduce((sum, r) => sum + r.orders, 0);\nconst totalRevenue = allRegions.reduce((sum, r) => sum + r.revenue, 0);\nconst avgOrderValue = totalRevenue / totalOrders;\n\n// Find best and worst performing regions\nconst bestRegion = allRegions.reduce((best, r) => \n  r.revenue > best.revenue ? r : best\n);\nconst worstRegion = allRegions.reduce((worst, r) => \n  r.revenue < worst.revenue ? r : worst\n);\n\n// Calculate variance from target (e.g., target is $80k daily)\nconst revenueTarget = 80000;\nconst targetVariance = ((totalRevenue - revenueTarget) / revenueTarget * 100).toFixed(2);\n\nconst report = {\n  reportDate: new Date().toISOString().split('T')[0],\n  generatedAt: new Date().toISOString(),\n  summary: {\n    totalOrders: totalOrders,\n    totalRevenue: totalRevenue,\n    avgOrderValue: parseFloat(avgOrderValue.toFixed(2)),\n    revenueTarget: revenueTarget,\n    targetVariance: parseFloat(targetVariance)\n  },\n  performance: {\n    bestRegion: {\n      name: bestRegion.region,\n      revenue: bestRegion.revenue,\n      orders: bestRegion.orders\n    },\n    worstRegion: {\n      name: worstRegion.region,\n      revenue: worstRegion.revenue,\n      orders: worstRegion.orders\n    }\n  },\n  regionalBreakdown: allRegions\n};\n\nreturn report;"
      },
