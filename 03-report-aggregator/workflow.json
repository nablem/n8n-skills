        "jsCode": "const data = $input.first().json;\n\nconst reportData = data.json || data;\n\nconst executionLog = {\n  executionId: `EXEC-${Date.now()}`,\n  executedAt: new Date().toISOString(),\n  reportDate: reportData.reportDate || new Date().toISOString().split('T')[0],\n  action: reportData.status === 'skipped' ? 'skipped' : 'sent',\n  summary: reportData.summary ? JSON.stringify(reportData.summary) : null,\n  skipReason: reportData.reason || null\n};\n\nreturn executionLog;"
