        "jsCode": "return [\n  {\n    region: \"Asia Pacific\",\n    date: \"2024-02-07\",\n    orders: 203,\n    revenue: 42100,\n    avgOrderValue: 207.39,\n    topProduct: \"Device Elite\"\n  }\n];"
