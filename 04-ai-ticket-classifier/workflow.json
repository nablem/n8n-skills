      "id": "c105d8e7-fbd4-4996-ae20-b449d78ecab5",
      "name": "Categorize Ticket w/ Claude"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst ticketData = $('Prepare AI Prompt & HTTP Body').first().json;\n\nconst aiText = response.content[0].text;\n\n// Extract JSON from markdown code block\nconst jsonMatch = aiText.match(/```json\\n([\\s\\S]*?)\\n```/);\nconst jsonString = jsonMatch ? jsonMatch[1] : aiText;\n\nconst classification = JSON.parse(jsonString);\n\nreturn {\n  ticketId: ticketData.ticketId,\n  customerEmail: ticketData.customerEmail,\n  urgency: classification.urgency,\n  category: classification.category,\n  reasoning: classification.reasoning,\n  classifiedAt: new Date().toISOString()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -16
      ],
      "id": "6497f02d-7c55-4f53-a3bc-2ce32e6a1c27",
      "name": "Parse AI Classification"
    },
    {
      "parameters": {
        "jsCode": "const ticket = $input.first().json.body;\n\nconst prompt = `Analyze this customer support ticket and classify it.\n\nSubject: ${ticket.subject}\nMessage: ${ticket.message}\n\nRespond with ONLY a JSON object in this exact format:\n{\n  \"urgency\": \"HIGH\" or \"MEDIUM\" or \"LOW\",\n  \"category\": \"TECHNICAL\" or \"BILLING\" or \"ACCOUNT\" or \"GENERAL\",\n  \"reasoning\": \"brief explanation\"\n}`;\n\nreturn {\n  ticketId: ticket.ticketId,\n  customerEmail: ticket.customerEmail,\n  apiBody: {\n    model: \"claude-haiku-4-5-20251001\",\n    max_tokens: 1024,\n    messages: [\n      {\n        role: \"user\",\n        content: prompt\n      }\n    ]\n  },\n  originalTicket: ticket\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -16
      ],
      "id": "ca3bd266-1fc4-4003-81bf-448b90c66dcc",
      "name": "Prepare AI Prompt & HTTP Body"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "668ad1bd-ce4b-453b-a899-31b1d71b22f7",
              "leftValue": "={{ $json.urgency === \"HIGH\" }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
