    {
      "parameters": {
        "jsCode": "// Use Code node instead of Set node\nconst data = $input.first().json;\n\nreturn {\n  ...data,\n  action: \"escalated\",\n  assignedTo: \"senior_support\",\n  priority: \"immediate\",\n  notifyVia: \"slack_and_email\"\n};"
      },
